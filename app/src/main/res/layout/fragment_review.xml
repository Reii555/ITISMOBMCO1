<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F1720"
    android:fillViewport="true"
    tools:context=".HomeFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- back button -->
        <Button
            android:id="@+id/backBtn"
            android:layout_width="55dp"
            android:layout_height="39dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:text="&lt;"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/reviewByUsernameTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="21dp"
                android:text="Review by @demonlikejudgeoffire"
                android:textColor="@color/white"
                android:textSize="12sp" />

            <View
                android:layout_width="10dp"
                android:layout_height="0dp" />

            <Button
                android:id="@+id/followBtn"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:backgroundTint="#2A3A4E"
                android:text="Follow"
                android:textSize="10sp" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="30dp"
            android:layout_marginEnd="30dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:background="#2A3748" />

        <!-- book info + book pic-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="209dp"
            android:orientation="horizontal"
            android:padding="20dp">

            <!-- book info row -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/bookTitleTv"
                    android:layout_width="160dp"
                    android:layout_height="wrap_content"
                    android:text="Omniscient Reader's Viewpoint, Vol. 1 (Engish)"
                    android:textColor="@color/white"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/publishDateTv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="5dp"
                    android:text="July 22, 2025"
                    android:textColor="@color/white" />

                <TextView
                    android:id="@+id/bookAuthorTv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="SingNsong"
                    android:textColor="@color/white" />

                <RatingBar
                    android:id="@+id/bookRatingBar"
                    style="?android:attr/ratingBarStyleSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:isIndicator="true"
                    android:numStars="5"
                    android:progressTint="#FFD700"
                    android:rating="4.5"
                    android:stepSize="0.5" />

            </LinearLayout>

            <!-- book pic row-->
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="183dp"
                android:paddingStart="60dp"
                tools:src="@drawable/orv1" />

        </LinearLayout>

        <TextView
            android:id="@+id/reviewDateTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="8dp"
            android:text="Read on July 22, 2025"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- review comment box -->
        <TextView
            android:id="@+id/reviewCommentTv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_edit_text"
            android:padding="16dp"
            android:text="I wish they would just kiss already!!!!!!!!"
            android:textColor="@color/white"
            android:textSize="14sp" />

        <!-- heart/like section -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/likeBtnIv"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Like review"
                android:src="@drawable/ic_heart" />

            <TextView
                android:id="@+id/likeCountTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="142 likes"
                android:textColor="#94A3B8"
                android:textSize="13sp" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="30dp"
            android:layout_marginEnd="30dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:background="#2A3748" />

        <!-- mutual user liking review -->
        <TextView
            android:id="@+id/mutualLikeTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:text="\@abyssalFlame also liked this review"
            android:textColor="@color/white"
            android:textSize="10sp" />

        <!-- Comments Section Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:padding="10dp"
            android:text="Comments"
            android:textColor="@color/white"
            android:textStyle="bold" />

        <!-- Comments RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/commentsRv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/item_comment" />

        <!-- Empty State (Shown when no comments exist) -->
        <TextView
            android:id="@+id/noCommentsTv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="20dp"
            android:text="No comments yet. Be the first to start the conversation!"
            android:textColor="#94A3B8"
            android:textSize="13sp"
            android:visibility="gone" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
