<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F1720"
    android:fillViewport="true"
    tools:context=".OtherUserProfileFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <!-- back button -->
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:src="@android:drawable/ic_media_previous"
            app:tint="#D9E9F7" />

        <!-- header -->
        <LinearLayout
            android:layout_width="250dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="8dp">

            <TextView
                android:id="@+id/tvDisplayName"
                android:layout_width="250dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/dmseriftext_regular"
                android:text="Wormboxd"
                android:paddingBottom="15dp"
                android:textAlignment="center"
                android:textColor="#D9E9F7"
                android:textSize="42sp"
                android:textStyle="bold" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivProfilePic"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:contentDescription="Profile picture"
                android:scaleType="centerCrop"
                android:src="@drawable/otherpfp"
                app:shapeAppearanceOverlay="@style/CircleImage" />

            <TextView
                android:id="@+id/tvUsername"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_variablefont_opsz_wght"
                android:text="\@otherusername"
                android:textAlignment="center"
                android:textColor="#D9E9F7"
                android:textSize="20sp" />

            <Button
                android:id="@+id/btnFollow"
                android:layout_width="150dp"
                android:layout_height="45dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#243B53"
                android:text="Follow"
                android:textColor="#D9E9F7" />
        </LinearLayout>

        <!-- recent activity -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#334C66"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="15dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="12dp"
            android:layout_marginLeft="20dp"
            android:fontFamily="@font/inter_variablefont_opsz_wght"
            android:text="Recent Activity"
            android:textColor="#D9E9F7"
            android:textSize="13sp" />

        <!-- ratings -->

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recentActivityRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:paddingLeft="20dp"
            android:paddingEnd="20dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/item_book" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#334C66"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="15dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="24dp"
            android:layout_marginLeft="20dp"
            android:fontFamily="@font/inter_variablefont_opsz_wght"
            android:text="Ratings"
            android:textColor="#D9E9F7"
            android:textSize="13sp" />

        <!-- recent reviews -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#334C66"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="15dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="12dp"
            android:layout_marginLeft="20dp"
            android:fontFamily="@font/inter_variablefont_opsz_wght"
            android:text="Recent Reviews"
            android:textColor="#D9E9F7"
            android:textSize="13sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/commentsRv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/item_comment_otheruser" />

    </LinearLayout>

</ScrollView>