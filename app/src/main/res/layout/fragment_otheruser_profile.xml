<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#0F1720"
    android:paddingTop="32dp"
    tools:context=".OtherUserProfileFragment">

    <LinearLayout
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:layout_width="250dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/dmseriftext_regular"
            android:text="Wormboxd"
            android:textAlignment="center"
            android:textColor="#D9E9F7"
            android:textSize="42sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:src="@drawable/profile_nav_icon" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_variablefont_opsz_wght"
            android:text="\@otherusername"
            android:textAlignment="center"
            android:textColor="#D9E9F7"
            android:textSize="20sp" />

        <Button
            android:layout_width="150dp"
            android:layout_height="45dp"
            android:backgroundTint="#243B53"
            android:text="Follow" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical" >

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#334C66"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="15dp"/>

        <TextView
            android:layout_width="390dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="24dp"
            android:layout_marginLeft="20dp"
            android:fontFamily="@font/inter_variablefont_opsz_wght"
            android:text="Recent Activity"
            android:textColor="#D9E9F7"
            android:textSize="13sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#334C66"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="15dp"/>

        <TextView
            android:layout_width="390dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="24dp"
            android:layout_marginLeft="20dp"
            android:fontFamily="@font/inter_variablefont_opsz_wght"
            android:text="Ratings"
            android:textColor="#D9E9F7"
            android:textSize="13sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#334C66"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="15dp"/>

        <TextView
            android:layout_width="390dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="24dp"
            android:layout_marginLeft="20dp"
            android:fontFamily="@font/inter_variablefont_opsz_wght"
            android:text="Recent Reviews"
            android:textColor="#D9E9F7"
            android:textSize="13sp" />

    </LinearLayout>

</LinearLayout>