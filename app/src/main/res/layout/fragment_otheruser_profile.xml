<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F1720"
    android:fillViewport="true"
    tools:context=".OtherUserProfileFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="32dp"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="250dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/tvDisplayName"
                android:layout_width="250dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/dmseriftext_regular"
                android:text="Wormboxd"
                android:textAlignment="center"
                android:textColor="#D9E9F7"
                android:textSize="42sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/ivProfilePic"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:src="@drawable/profile_nav_icon"
                android:contentDescription="Profile picture" />

            <TextView
                android:id="@+id/tvUsername"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_variablefont_opsz_wght"
                android:text="\@otherusername"
                android:textAlignment="center"
                android:textColor="#D9E9F7"
                android:textSize="20sp" />

            <Button
                android:id="@+id/btnFollow"
                android:layout_width="150dp"
                android:layout_height="45dp"
                android:backgroundTint="#243B53"
                android:text="Follow"
                android:textColor="#D9E9F7" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#334C66"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="15dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="12dp"
            android:layout_marginLeft="20dp"
            android:fontFamily="@font/inter_variablefont_opsz_wght"
            android:text="Recent Activity"
            android:textColor="#D9E9F7"
            android:textSize="13sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recentActivityRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="20dp"
            android:clipToPadding="false"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            android:orientation="horizontal"
            tools:listitem="@layout/fragment_home_book" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#334C66"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="15dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="24dp"
            android:layout_marginLeft="20dp"
            android:fontFamily="@font/inter_variablefont_opsz_wght"
            android:text="Ratings"
            android:textColor="#D9E9F7"
            android:textSize="13sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#334C66"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="15dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="12dp"
            android:layout_marginLeft="20dp"
            android:fontFamily="@font/inter_variablefont_opsz_wght"
            android:text="Recent Reviews"
            android:textColor="#D9E9F7"
            android:textSize="13sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/commentsRv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/item_comment" />

    </LinearLayout>

</ScrollView>