<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#0F1720"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/wormboxdTitleTv"
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/dmseriftext_regular"
        android:text="WormBoxd"
        android:textColor="#D9E9F7"
        android:textSize="50sp"
        android:textStyle="bold"
        android:layout_marginBottom="20dp"/>

    <TextView
        android:id="@+id/loginTv"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/dmseriftext_regular"
        android:text="Login"
        android:textAlignment="center"
        android:textColor="#D9E9F7"
        android:textSize="27sp"
        android:textStyle="bold"
        android:layout_marginBottom="15dp"/>

    <EditText
        android:id="@+id/emailTv"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:hint="Email Address"
        android:inputType="textEmailAddress"
        android:textColor="#D9E9F7"
        android:fontFamily="@font/dmseriftext_regular"
        android:padding="5dp"
        android:textColorHint="#D9E9F7"
        android:textSize="20sp" />

    <EditText
        android:id="@+id/passwordTv"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:hint="Password"
        android:fontFamily="@font/dmseriftext_regular"
        android:inputType="textPassword"
        android:textColor="#D9E9F7"
        android:padding="5dp"
        android:textColorHint="#D9E9F7"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/registrationTv"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:padding="5dp"
        android:text="Don't have an account? Sign up here."
        android:fontFamily="@font/dmseriftext_regular"
        android:textColor="#D9E9F7"
        android:textSize="10sp" />

    <Button
        android:id="@+id/loginBtn"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:text="Login"
        android:fontFamily="@font/dmseriftext_regular"
        android:textColor="#1F2933"
        android:textSize="15sp"
        android:backgroundTint="#F7F8FA"/>


</LinearLayout>