<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingVertical="18dp"
    android:paddingHorizontal="20dp"
    android:background="#0d131a"
    android:layout_marginBottom="8dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/reviewDateTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_variablefont_opsz_wght"
            android:text="September 25, 2026"
            android:textSize="12sp"
            android:textColor="#9AAABD" />

        <TextView
            android:id="@+id/reviewBookTV"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_variablefont_opsz_wght"
            android:text="The Maze Runner"
            android:textSize="18sp"
            android:textColor="#D9E9F7"
            android:layout_marginVertical="4dp"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center" >

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/star_rating"
                android:layout_marginRight="4dp"/>

            <TextView
                android:id="@+id/reviewRatingTV"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_variablefont_opsz_wght"
                android:text="4.8"
                android:textColor="#9AAABD"
                android:textSize="12sp"/>

        </LinearLayout>

        <TextView
            android:id="@+id/reviewContentTV"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_variablefont_opsz_wght"
            android:text="BEST DYSTOPIAN FILM EVER. I wish I can watch this again for the first time!"
            android:textSize="14sp"
            android:textColor="#D9E9F7"
            android:layout_marginVertical="8dp"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_heart"
                android:layout_marginRight="4dp"/>

            <TextView
                android:id="@+id/reviewLikesTV"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_variablefont_opsz_wght"
                android:text="25, 314 Likes"
                android:textColor="#9AAABD"
                android:textSize="12sp"/>

        </LinearLayout>

    </LinearLayout>

    <ImageView
        android:id="@+id/reviewBookIV"
        android:layout_width="100dp"
        android:layout_height="140dp"
        android:src="@drawable/the_maze_runner"
        android:scaleType="centerCrop"
        android:contentDescription="The Maze Runner book cover"
        android:layout_marginLeft="8dp"/>

</LinearLayout>